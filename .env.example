# Copy to .env and fill in real values. Never commit .env.

# Supabase — safe to expose in the client bundle (protected by RLS).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Razorpay key id — safe to expose in the client bundle, needed to open checkout.
EXPO_PUBLIC_RAZORPAY_KEY_ID=

# Razorpay key secret — SERVER-SIDE ONLY. Never prefix with EXPO_PUBLIC_.
# Used by the create-razorpay-order Edge Function to create orders — set via
# `supabase secrets set RAZORPAY_KEY_SECRET=...`, not shipped in the app.
RAZORPAY_KEY_SECRET=

# Razorpay webhook secret — SERVER-SIDE ONLY. This is a passphrase you invent
# yourself and paste into the Razorpay Dashboard's webhook "Secret" field
# (Razorpay does not generate one for you); the razorpay-webhook Edge
# Function uses the same value to verify each callback's signature. Set via
# `supabase secrets set RAZORPAY_WEBHOOK_SECRET=...`.
RAZORPAY_WEBHOOK_SECRET=
