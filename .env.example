# Copy to .env and fill in real values. Never commit .env.

# Supabase — safe to expose in the client bundle (protected by RLS).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Razorpay key id — safe to expose in the client bundle, needed to open checkout.
EXPO_PUBLIC_RAZORPAY_KEY_ID=

# Razorpay key secret — SERVER-SIDE ONLY. Never prefix with EXPO_PUBLIC_.
# Used later by the Supabase Edge Function that verifies webhook signatures
# and creates orders — set it via `supabase secrets set RAZORPAY_KEY_SECRET=...`,
# not by shipping it in the app.
RAZORPAY_KEY_SECRET=
